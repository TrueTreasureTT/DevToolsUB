{
  "name": "devtools-unblocker",
  "version": "1.0.0",
  "private": true,
  "description": "A local developer overlay with browser-extension and desktop shells.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "build:wasm": "wasm-pack build wasm --target web --out-dir pkg",
    "dev:electron": "npm run build && electron desktop/electron/index.js",
    "dev:tauri": "tauri dev"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "electron": "^39.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.1.0"
  }
}
